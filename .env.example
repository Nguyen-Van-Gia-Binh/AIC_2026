# API Keys — KHÔNG commit file này, thêm vào .gitignore
# Copy file này thành .env và điền key thật vào

# Google Gemini (gọi thẳng Google AI Studio, không qua OpenRouter — miễn phí, hào phóng nhất).
# Chỉ được dùng khi AIC_MODE=test: PROVIDER_CHAIN trong scripts/agent/config.py xoay vòng qua
# GEMINI_DIRECT_MODELS (8 model Flash, ưu tiên model RPD cao trước) × toàn bộ key liệt kê ở đây,
# rồi mới rơi xuống OpenRouter khi mọi (model, key) đều lỗi. AIC_MODE=contest bỏ qua biến này hoàn
# toàn, chỉ dùng OpenRouter cho ổn định.
# Có thể để 1 key, hoặc nhiều key xoay vòng để né rate-limit theo từng key — cách nhau bằng dấu
# phẩy trên 1 dòng, hoặc mỗi key 1 dòng trong dấu ngoặc kép:
#   GEMINI_API_KEY=key1,key2,key3
#   GEMINI_API_KEY="key1
#   key2
#   key3"
# (GROQ_API_KEY/NVIDIA_NIM_API_KEY bên dưới cũng hỗ trợ cú pháp này nếu sau này có nhiều key)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (tốc độ cao, free tier) — fallback 2 khi Gemini rate-limit (xem PROVIDER_CHAIN trong
# scripts/agent/config.py)
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (build.nvidia.com, free tier) — fallback 3, dùng khi cả Gemini lẫn Groq đều lỗi
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Mistral (free tier) — chưa nối vào PROVIDER_CHAIN, để dành nếu cần fallback thêm
MISTRAL_API_KEY=your_mistral_api_key_here

# Cerebras (free tier) — chưa nối vào PROVIDER_CHAIN, để dành nếu cần fallback thêm
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter (luôn là luới an toàn cuối — AIC_MODE=contest dùng riêng đây, AIC_MODE=test rơi xuống
# đây chỉ khi mọi model/key Gemini trực tiếp ở trên đều lỗi. Xem scripts/agent/config.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model OpenRouter dùng khi AIC_MODE=test — free/rẻ, chỉ được gọi khi GEMINI_API_KEY trống hoặc hết
# quota cả 8 model. Nên chọn model :free có vision (vd google/gemma-4-26b-a4b-it:free).
OPENROUTER_MODEL=google/gemini-3.7-flash

# Model dùng khi AIC_MODE=contest (mạnh hơn, dùng lúc nộp thật). Nếu để trống, contest mode sẽ tự
# rơi về OPENROUTER_MODEL kèm cảnh báo trong log.
OPENROUTER_MODEL_CONTEST=

# ─── LM Studio (chạy trên máy, 0 đồng) ────────────────────────────────────────
# Chỉ được dùng khi AIC_MODE=local. LiteLLM gọi qua tiền tố lm_studio/ nên không cần thêm thư viện.
# AIC_MODE=local KHÔNG có fallback trả phí — nếu LM Studio chưa bật thì báo lỗi to, cố ý như vậy để
# không bao giờ âm thầm tiêu tiền khi tưởng đang chạy miễn phí.
# LM_STUDIO_MODEL phải khớp tên model đang nạp trong LM Studio.
# Máy đích 8 GB VRAM: khuyến nghị Qwen2.5-VL-7B-Instruct GGUF Q4_K_M (lo được cả text lẫn vision).
LM_STUDIO_BASE=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-vl-7b-instruct

# ─── Chế độ chạy ──────────────────────────────────────────────────────────────
#   local   — LM Studio trên máy. 0 đồng. Dùng cho smoke test / vòng lặp sửa code.
#             ⚠️ KHÔNG dùng để lấy số đo so sánh (model 7B lượng tử hoá ≠ model thi).
#   test    — Gemini free tier → OpenRouter. Rẻ. ĐÂY là chế độ để ĐO.
#   contest — chỉ OpenRouter (OPENROUTER_MODEL_CONTEST). Đắt. Chỉ dùng lúc nộp thật.
AIC_MODE=test
