# API Keys — KHÔNG commit file này, thêm vào .gitignore
# Copy file này thành .env và điền key thật vào

# Google Gemini (miễn phí, hào phóng nhất — dùng trước)
# Có thể để 1 key, hoặc nhiều key xoay vòng để né rate-limit theo từng key — cách nhau bằng dấu
# phẩy trên 1 dòng, hoặc mỗi key 1 dòng trong dấu ngoặc kép:
#   GEMINI_API_KEY=key1,key2,key3
#   GEMINI_API_KEY="key1
#   key2
#   key3"
# (GROQ_API_KEY/NVIDIA_NIM_API_KEY bên dưới cũng hỗ trợ cú pháp này nếu sau này có nhiều key)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (tốc độ cao, free tier) — fallback 2 khi Gemini rate-limit (xem PROVIDER_CHAIN trong
# scripts/agent/config.py)
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (build.nvidia.com, free tier) — fallback 3, dùng khi cả Gemini lẫn Groq đều lỗi
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Mistral (free tier) — chưa nối vào PROVIDER_CHAIN, để dành nếu cần fallback thêm
MISTRAL_API_KEY=your_mistral_api_key_here

# Cerebras (free tier) — chưa nối vào PROVIDER_CHAIN, để dành nếu cần fallback thêm
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter (dùng thực tế — mọi lời gọi LLM trong repo đi qua đây, xem scripts/agent/config.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model dùng khi AIC_MODE=test (mặc định, rẻ, dùng lúc dev)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Model dùng khi AIC_MODE=contest (mạnh hơn, dùng lúc nộp thật). Nếu để trống, contest mode sẽ tự
# rơi về OPENROUTER_MODEL kèm cảnh báo trong log.
OPENROUTER_MODEL_CONTEST=

# Chế độ chọn model: "test" (mặc định) hoặc "contest". Không set = hành vi y hệt trước đây.
AIC_MODE=test
